<div class="post-header">
    <a class="logo" href="<%- url_for() %>"><%= config.title %></a>
    <!-- <div class="logo"><a href="/" title="Len"><img src="/img/logo.svg" alt="Len" aria-label="logo" height="20"></a></div> -->
        <ul class="nav">
            <% var index = 0; %>
            <% for (name in theme.menu) { %>
            <% if (index > 0) { %><li class="nav-sep"> / </li><% } %>
            <% var menuVal = theme.menu[name].replace(/[<>"]/g, '').trim(); %>
            <% var parts = menuVal.split(' || '); %>
            <% var url = parts[0]; %>
            <% var icon = parts[1] || ''; %>
            <li><a href="<%- url_for(url) %>"><% if (icon) { %><i class="<%= icon %>"></i> <% } %><%= name %></a></li>
            <% index++; %>
            <% } %>
        </ul>


    </a>
</div>
