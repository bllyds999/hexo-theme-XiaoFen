<!DOCTYPE html>
<html>
    <%- partial('_partial/head') %>
    <body>
        <div class="paper">
            <div class="paper-main">
                <% if (is_post() || is_page()) { %>
                    <%- partial('_partial/post-header') %>
                <% } else { %>
                    <%- partial('_partial/header') %>
                <% } %>
                <% if (page.type === 'about') { %>
                <div class="about-page">
                    <p>Hello, welcome to <%= config.title %>.</p>
                    <h2>About Me</h2>
                    <p>I'am <%= config.author %>.</p>
                    <h2>About Site</h2>
                    <p><%= config.description %></p>
                </div>
                <% } else if (page.type === 'friends') { %>
                <div class="friends-page">
                    <% if (theme.friends && theme.friends !== false) { %>
                        <% for (var name in theme.friends) { %>
                            <% var val = theme.friends[name]; %>
                            <% if (typeof val === 'string') { %>
                                <% var parts = val.split(' || '); %>
                                <% var url = parts[0].trim(); %>
                                <% var desc = parts[1] ? parts[1].trim() : ''; %>
                    <div class="friend-item">
                        <h2><%= name %></h2>
                        <% if (desc) { %><p><%= desc %></p><% } %>
                        <a href="<%- url %>" target="_blank" rel="noopener">Go</a>
                    </div>
                            <% } %>
                        <% } %>
                    <% } %>
                </div>
                <% } else { %>
                <%- body %>
                <% } %>
                <% if ((is_post() || is_page()) && theme.comments && theme.comments !== false) { %>
                <div class="comments">
                    <h2>Comments</h2>
                    <%- theme.comments %>
                </div>
                <% } %>
                <%- partial('_partial/footer') %>
            </div>
        </div>
    </body>
</html>